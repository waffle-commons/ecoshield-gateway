# Copiez en .env pour un développement local hors Docker.
# Sous Docker, docker-compose.yml fournit déjà ces valeurs.

APP_ENV=dev
APP_DEBUG=true

# Le monolithe à protéger. Fixé par l'exploitant, jamais par un client.
UPSTREAM_URL=http://legacy-nginx:80

# array | file | redis — 'redis' est le seul choix correct à plus d'un réplica :
# un cache par worker multiplie les appels au legacy par le nombre de workers.
CACHE_ADAPTER=redis
REDIS_DSN=redis://redis:6379

# Requêtes servies avant recyclage du worker.
MAX_REQUESTS=2000

{
    "name": "waffle-commons/ecoshield-gateway",
    "description": "FinOps-driven Strangler-Fig API gateway POC: intercept, proxy and cache a legacy PHP monolith from a FrankenPHP worker.",
    "type": "project",
    "keywords": [
        "gateway",
        "reverse-proxy",
        "strangler-fig",
        "finops",
        "green-it",
        "frankenphp",
        "worker-mode",
        "legacy-modernization",
        "psr-15"
    ],
    "homepage": "https://github.com/waffle-commons/ecoshield-gateway",
    "license": "MIT",
    "authors": [
        {
            "name": "Leslie Petrimaux",
            "email": "contact@waffle-commons.cloud"
        }
    ],
    "support": {
        "issues": "https://github.com/waffle-commons/ecoshield-gateway/issues",
        "source": "https://github.com/waffle-commons/ecoshield-gateway"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AppTests\\": "tests/src/"
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "waffle-commons/cache": "^0.1.0-beta6",
        "waffle-commons/config": "^0.1.0-beta6",
        "waffle-commons/container": "^0.1.0-beta6",
        "waffle-commons/contracts": "^0.1.0-beta6",
        "waffle-commons/error-handler": "^0.1.0-beta6",
        "waffle-commons/http": "^0.1.0-beta6",
        "waffle-commons/http-client": "^0.1.0-beta6",
        "waffle-commons/log": "^0.1.0-beta6",
        "waffle-commons/pipeline": "^0.1.0-beta6",
        "waffle-commons/routing": "^0.1.0-beta6",
        "waffle-commons/runtime": "^0.1.0-beta6",
        "waffle-commons/security": "^0.1.0-beta6",
        "waffle-commons/utils": "^0.1.0-beta6",
        "waffle-commons/waffle": "^0.1.0-beta6"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "carthage-software/mago": "^1.29",
        "cyclonedx/cyclonedx-php-composer": "^6.2",
        "igor-php/igor-php": "^0.7.0"
    },
    "scripts": {
        "formatter": "vendor/bin/mago fmt",
        "linter": "vendor/bin/mago lint",
        "analyzer": "vendor/bin/mago analyze",
        "guard": "vendor/bin/mago guard",
        "igor": "vendor/bin/igor-php .",
        "phpunit": "vendor/bin/phpunit --log-junit var/data/phpunit-coverage/junit.xml --coverage-html var/data/phpunit-coverage",
        "mago": [
            "@formatter",
            "@linter",
            "@analyzer",
            "@guard"
        ],
        "tests": [
            "@phpunit"
        ],
        "scan": [
            "@mago",
            "@tests"
        ],
        "ci": [
            "@mago",
            "@tests",
            "composer audit"
        ],
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"is_dir('var/cache/shield') || mkdir('var/cache/shield', 0775, true);\"",
            "@php -r \"is_dir('var/log') || mkdir('var/log', 0775, true);\""
        ]
    },
    "config": {
        "allow-plugins": {
            "carthage-software/mago": true,
            "cyclonedx/cyclonedx-php-composer": true
        },
        "sort-packages": true
    }
}

composer.phar
/vendor/
/var/

# `composer create-project` génère .env depuis .env.example. Sans cette règle,
# un fichier contenant l'URL de l'amont et le DSN Redis d'un déploiement réel
# pourrait être commité par inadvertance. Le modèle, lui, reste suivi.
/.env

# Commit your application's lock file https://getcomposer.org/doc/01-basic-usage.md#commit-your-composer-lock-file-to-version-control
# You may choose to ignore a library lock file http://getcomposer.org/doc/02-libraries.md#lock-file
# composer.lock


# Sorties de mesure : les CSV agrégés et les rapports sont versionnés (ce sont
# les preuves derrière les chiffres du README), les résumés k6 par marche ne le
# sont pas — ils sont volumineux, illisibles, et intégralement reconstruits par
# `bench/ladder.sh`.
/bench/results/step-*.json
/bench/results/soak-summary.json

# Brouillon de description de release : support de rédaction pour la publication
# GitHub, pas un document du dépôt. Il duplique volontairement le CHANGELOG et le
# README — le versionner créerait une troisième source à tenir à jour.
/RELEASE.md
